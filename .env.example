# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: servers where slash commands are registered instantly at startup,
# comma-separated (DISCORD_GUILD_ID with a single id also works). Leave empty and run
# "npm run deploy-commands -- --global" to make them available everywhere.
DISCORD_GUILD_IDS=
# Optional: the only servers where the bot works (comma-separated). It leaves any other server it is
# added to and rejects interactions from them. Defaults to DISCORD_GUILD_IDS; empty = any server.
ALLOWED_GUILD_IDS=

# Optional: improves Spotify playlist/album resolution (works without it)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional settings
# Default language for bot replies: es | en
DEFAULT_LOCALE=es
# Seconds to wait alone/idle before leaving the voice channel
IDLE_TIMEOUT_SECONDS=180
# SQLite file for per-guild settings
DATABASE_PATH=./data/rockola.sqlite
# Path to yt-dlp and ffmpeg binaries (defaults: found in PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional yt-dlp tweaks: JavaScript runtime for YouTube challenges (deno is yt-dlp's default;
# the Docker image uses node), a persistent cache folder, and a Netscape cookies file if
# YouTube asks to "confirm you're not a bot" (use a throwaway account).
# YTDLP_JS_RUNTIME=node
# YTDLP_CACHE_DIR=./data/yt-dlp-cache
# YTDLP_COOKIES=./data/cookies.txt
# Docker only: upgrade yt-dlp at container start instead of using the image's pinned version
# (default false; 2026.11.23 broke long YouTube videos with 403s)
# YTDLP_AUTO_UPDATE=false
# Songs a server's queue can hold, and yt-dlp processes running at once (all servers)
# MAX_QUEUE_SIZE=1000
# YTDLP_MAX_CONCURRENCY=4
# debug | info | warn | error
LOG_LEVEL=info
