# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly in one test server
DISCORD_GUILD_ID=

# Optional: improves Spotify playlist/album resolution (works without it)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional settings
# Default language for bot replies: es | en
DEFAULT_LOCALE=es
# Seconds to wait alone/idle before leaving the voice channel
IDLE_TIMEOUT_SECONDS=180
# SQLite file for per-guild settings
DATABASE_PATH=./data/rockola.sqlite
# Path to yt-dlp and ffmpeg binaries (defaults: found in PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional yt-dlp tweaks: JavaScript runtime for YouTube challenges (deno is yt-dlp's default;
# the Docker image uses node), a persistent cache folder, and a Netscape cookies file if
# YouTube asks to "confirm you're not a bot" (use a throwaway account).
# YTDLP_JS_RUNTIME=node
# YTDLP_CACHE_DIR=./data/yt-dlp-cache
# YTDLP_COOKIES=./data/cookies.txt
# Docker only: upgrade yt-dlp at container start (default true)
# YTDLP_AUTO_UPDATE=true
# debug | info | warn | error
LOG_LEVEL=info
