#!/bin/sh
# Block commits that contain secrets. Install: pnpm install (runs "prepare"),
# or: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (https://github.com/gitleaks/gitleaks). Install it to commit." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
